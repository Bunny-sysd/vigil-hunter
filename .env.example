# Vigil — AI Provider Configuration
# Copy this to .env and fill in your keys

# Google Gemini (primary)
VIGIL_GEMINI_KEY=

# OpenAI (alternative)
VIGIL_OPENAI_KEY=

# Ollama (local — no key needed)
VIGIL_OLLAMA_ENDPOINT=http://localhost:11434
VIGIL_OLLAMA_MODEL=llama3.1

# Default provider: gemini | openai | ollama
VIGIL_PROVIDER=gemini
